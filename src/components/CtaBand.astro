---
import Icon from './Icon.astro';
import { company } from '../data/site.js';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Votre voiture mérite mieux qu’un coup d’éponge.',
  text = 'Passez en station, 7 jours sur 7, ou confiez-nous votre véhicule sur rendez-vous.',
} = Astro.props;
---

<section class="cta">
  <div class="cta__bg" aria-hidden="true">
    <img src="/img/station-pistes.webp" alt="" loading="lazy" data-parallax="16" />
  </div>
  <div class="wrap cta__inner" data-reveal>
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta__actions">
      <a class="btn" href={company.phoneHref}><Icon name="phone" /> {company.phone}</a>
      <a class="btn btn--ghost" href="/#stations"><Icon name="pin" /> Nos stations</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    color: var(--white);
    padding-block: clamp(96px, 14vw, 180px);
    background: var(--ink);
  }

  .cta__bg {
    position: absolute;
    inset: 0;
  }

  .cta__bg img {
    width: 100%;
    height: 130%;
    margin-top: -15%;
    object-fit: cover;
    opacity: 0.35;
  }

  .cta__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(26, 26, 26, 0.95) 20%, rgba(216, 36, 0, 0.35));
  }

  .cta__inner {
    position: relative;
    max-width: var(--wrap);
  }

  .cta h2 {
    max-width: 16ch;
  }

  .cta p {
    margin-top: 20px;
    font-size: 1.2rem;
    color: #d6d6d6;
    max-width: 48ch;
  }

  .cta__actions {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
</style>
