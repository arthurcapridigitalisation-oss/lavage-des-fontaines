---
import Icon from './Icon.astro';
import { stations } from '../data/site.js';

const cards = [
  {
    s: stations.marnaz,
    img: { src: '/img/marnaz-accueil.webp', w: 1360, h: 1020, alt: 'Accueil et pistes de la station de Marnaz' },
    highlights: ['2 portiques SoftCar Pro 2', '3 pistes haute pression', 'Piste chauffée l’hiver', 'Lave-tapis automatique'],
  },
  {
    s: stations.scionzier,
    img: { src: '/img/station-nuit.webp', w: 1264, h: 1020, alt: 'La station de Scionzier éclairée de nuit' },
    highlights: ['Ouvert 24h/24', 'Shampouineuse sièges', 'Distributeur dernière génération', 'Boutique 7j/7'],
  },
];
---

<section class="section section--light" id="stations">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">Nos stations</p>
      <h2>Deux stations, <span class="text-grad">un même niveau d’exigence</span></h2>
      <p class="lead">Entre Bonneville et Cluses, au cœur de la vallée de l’Arve. Choisissez la plus proche de vous.</p>
    </div>

    <div class="st-grid">
      {
        cards.map(({ s, img, highlights }) => (
          <article class="st-card" data-reveal>
            <a class="st-card__media" href={`/${s.slug}/`} tabindex="-1" aria-hidden="true">
              <img src={img.src} alt="" width={img.w} height={img.h} loading="lazy" />
              <span class="st-card__label">{s.name}</span>
            </a>
            <div class="st-card__body">
              <div class="st-card__top">
                <h3>
                  <a href={`/${s.slug}/`}>Station {s.name}</a>
                </h3>
                <p class="st-card__rating">
                  <Icon name="star" /> {String(s.rating).replace('.', ',')} <span>({s.reviews} avis)</span>
                </p>
              </div>
              <ul class="st-card__facts">
                <li>
                  <Icon name="pin" /> {s.address}, {s.city}
                </li>
                <li>
                  <Icon name="clock" /> {s.hoursLabel}
                </li>
              </ul>
              <ul class="st-card__tags">
                {highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <div class="st-card__actions">
                <a class="btn" href={`/${s.slug}/`}>
                  Voir la station <Icon name="arrow" />
                </a>
                <a
                  class="st-card__route"
                  href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.mapsQuery)}`}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="route" /> Itinéraire
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .st-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .st-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px -30px rgba(0, 0, 0, 0.35);
  }

  .st-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .st-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .st-card:hover .st-card__media img {
    transform: scale(1.06);
  }

  .st-card__label {
    position: absolute;
    left: 0;
    bottom: 22px;
    padding: 6px 28px 6px 22px;
    background: var(--grad);
    color: var(--white);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    font-size: 1.8rem;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 16px) 100%, 0 100%);
  }

  .st-card__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    flex: 1;
  }

  .st-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .st-card h3 a {
    text-decoration: none;
  }

  .st-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .st-card__rating span {
    color: var(--grey-text);
    font-weight: 400;
  }

  .st-card__rating :global(svg) {
    width: 18px;
    height: 18px;
    fill: #ffb400;
    stroke: #ffb400;
  }

  .st-card__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: #444;
  }

  .st-card__facts li {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .st-card__facts :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--orange);
    flex: none;
  }

  .st-card__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .st-card__tags li {
    padding: 6px 12px;
    border-radius: 30px;
    background: var(--grey-2);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .st-card__actions {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .st-card__route {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    text-decoration: none;
  }

  .st-card__route:hover {
    color: var(--orange);
  }

  .st-card__route :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 860px) {
    .st-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
